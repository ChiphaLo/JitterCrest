SPEEDTEST_HOST=127.0.0.1
PORT=3010
SPEEDTEST_NODE_NAME=speedtest-rust
ALLOWED_ORIGINS=https://speed.example.com
TRUST_PROXY_HEADERS=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
SPEEDTEST_NODES='[{"id":"local","label":"Local server","base":""}]'
# Enable only after setting a real public IPv4 and validating UDP reachability.
SPEEDTEST_WEBRTC_UDP4=
SPEEDTEST_RUST_RTC_EXPERIMENTAL=0
SPEEDTEST_RTC_LEGACY_CONTROL=0
RUST_LOG=speedtest_rust=info,warn
