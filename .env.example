# JitterCrest: example environment settings; replace placeholders before deployment.
SPEEDTEST_HOST=127.0.0.1
PORT=32132
SPEEDTEST_NODE_NAME=speedtest-cpp
SPEEDTEST_IO_THREADS=2
MAX_HTTP_CONNECTIONS=4096
ALLOWED_ORIGINS=https://speed.example.com
TRUST_PROXY_HEADERS=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
SPEEDTEST_NODES='[{"id":"local","label":"Local server","base":""}]'
# Legacy key name only; the C++ service never invokes Rust.
# Enable only after configuring a real public IPv4 and testing UDP/TLS.
SPEEDTEST_WEBRTC_UDP4=
SPEEDTEST_RUST_RTC_EXPERIMENTAL=0
SPEEDTEST_RTC_LEGACY_CONTROL=0

# Optional public TLS listener with HTTP/2 receive windows sized for multi-Gbit/s
# single-stream uploads. It relays to PORT, so TRUST_PROXY_HEADERS=1 and
# SPEEDTEST_HOST in TRUSTED_PROXY_IPS are required. Certificate files are
# re-read when they change.
SPEEDTEST_TLS_PORT=0
SPEEDTEST_TLS_HOST=0.0.0.0
SPEEDTEST_TLS_CERT=
SPEEDTEST_TLS_KEY=

# Main UI only. Set all three to enable /admin; keep the token private.
# quickstart.py generates these settings automatically for a main node.
SPEEDTEST_ADMIN_TOKEN=
SPEEDTEST_ADMIN_STATE=
SPEEDTEST_PUBLIC_ORIGIN=
# Set by the generated agent installer; never put agent credentials in frontend configuration.
SPEEDTEST_CONTROLLER_ORIGIN=
SPEEDTEST_AGENT_ID=
SPEEDTEST_AGENT_KEY=
