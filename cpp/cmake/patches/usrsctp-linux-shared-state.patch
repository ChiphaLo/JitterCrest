+#if defined(__Userspace__) && defined(__linux__)
+#define SCTP_SHARED_STORE32(address, value) __atomic_store_n((address), (value), __ATOMIC_RELAXED)
+#define SCTP_SHARED_LOAD32(address) __atomic_load_n((address), __ATOMIC_RELAXED)
+#define SCTP_SHARED_TAKE32(address) __atomic_exchange_n((address), 0, __ATOMIC_RELAXED)
