FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive CC=clang-18 CXX=clang++-18
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git clang-18 lld-18 cmake ninja-build build-essential \
    libboost-system1.83-dev libssl-dev libcurl4-openssl-dev nlohmann-json3-dev python3 \
    && rm -rf /var/lib/apt/lists/*
COPY cpp/cmake/bootstrap-datachannel.sh /src/cpp/cmake/bootstrap-datachannel.sh
COPY cpp/cmake/patches /src/cpp/cmake/patches
RUN bash /src/cpp/cmake/bootstrap-datachannel.sh /native
COPY . /src
RUN cmake -S /src/cpp -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_COMPILER=clang++-18 -DCMAKE_PREFIX_PATH=/native/install \
      -DSPEEDTEST_WEB_UI=OFF \
    && cmake --build /build --parallel 2 \
    && ctest --test-dir /build --output-on-failure \
    && python3 /src/cpp/deploy/package_release.py --build /build \
      --native-source /native/src/libdatachannel --license /src/LICENSE --output /release
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /release /opt/jittercrest
USER 65532:65532
ENTRYPOINT ["/opt/jittercrest/speedtest-cpp"]
